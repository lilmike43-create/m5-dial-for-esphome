# ========================================
# Secrets Template for M5 Dial ESPHome
# ========================================
# Rename this file to 'secrets.yaml' and fill in your values

# WiFi Credentials
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# API Encryption Key
# Generate with: esphome run your-config.yaml
# Or generate manually: openssl rand -base64 32
api_encryption_key: "your-32-character-base64-key-here"

# OTA Password
# Use a strong password for over-the-air updates
ota_password: "your-secure-ota-password"
